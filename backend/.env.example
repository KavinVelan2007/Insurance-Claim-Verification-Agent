# Kaagaz backend configuration — copy to backend/.env

# --- Database (Supabase Postgres) ---
# Supabase dashboard -> Connect -> Session pooler (port 5432) or direct connection URI
DATABASE_URL=postgresql://postgres.YOUR-REF:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Kaagaz keeps its tables in this Postgres schema (safe in a shared database)
DB_SCHEMA=kaagaz

# --- Secrets (generate, never commit) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this key makes stored PDFs unreadable.
FILE_ENCRYPTION_KEY=

# --- AI (OpenRouter, or any OpenAI-compatible API) ---
# Key: https://openrouter.ai/keys . Requests are routed only to providers that don't collect prompt data.
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.5-flash
LLM_BASE_URL=https://openrouter.ai/api/v1
# Local alternative (no key): LLM_BASE_URL=http://localhost:11434/v1 with a vision model in LLM_MODEL
# Reasoning effort for reasoning models (low keeps cost/latency down); blank for non-reasoning models
LLM_REASONING=low
LLM_TIMEOUT_S=180
MAX_IMAGE_PAGES=10

# --- Web ---
# Comma-separated frontend origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:5173
# true when served over HTTPS
COOKIE_SECURE=false
SESSION_HOURS=12

# --- Limits & retention ---
MAX_UPLOAD_MB=15
MAX_FILES=20
RETENTION_DAYS=90
# false if you run the worker separately: python -m app.worker
WORKER_ENABLED=true
