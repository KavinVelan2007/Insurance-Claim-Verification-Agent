# ClaimLens AI — backend configuration
# Copy to .env to override defaults
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=granite3-moe:3b
OLLAMA_VLM_MODEL=
OLLAMA_TIMEOUT_S=120
MAX_UPLOAD_MB=15
# Supabase Postgres — paste your URI connection string (port 5432, NOT the pooler):
# Supabase dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-REF.supabase.co:5432/postgres?sslmode=require
